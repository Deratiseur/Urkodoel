// Versions alternatives pour l'amulette : sorts de niveaux 2 a 7, reduits d'un niveau.
// Le niveau 1 ne peut pas etre abaisse au niveau 0. Niveaux 8, 9 et epiques exclus.
// Cécité et Protection contre la pétrification : conversion niveau 2 -> 1 sous IWDEE uniquement.
ACTION_IF GAME_IS ~IWDEE~ THEN BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~pxu2106.spl~ THEN BEGIN
        COPY_EXISTING ~pxu2106.spl~ ~override/pxv2106.spl~ LPF SPELL_TO_CLERIC_ALT INT_VAR niveau = 1 END
        COPY_EXISTING ~pxugbase.spl~ ~override/pxh2106.spl~ WRITE_ASCII 0xae ~pxv2106~ #8
    END
    ACTION_IF FILE_EXISTS_IN_GAME ~pxu2108.spl~ THEN BEGIN
        COPY_EXISTING ~pxu2108.spl~ ~override/pxv2108.spl~ LPF SPELL_TO_CLERIC_ALT INT_VAR niveau = 1 END
        COPY_EXISTING ~pxugbase.spl~ ~override/pxh2108.spl~ WRITE_ASCII 0xae ~pxv2108~ #8
    END
END

