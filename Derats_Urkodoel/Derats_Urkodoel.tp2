/////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////   INTERPLAN   ///////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////

ACTION_IF FILE_EXISTS_IN_GAME ~pxl2ex2a.itm~ THEN BEGIN

// Resolve each installed spell independently. Do not reinstall Interplan spells.
DEFINE_ACTION_FUNCTION PXO_INTERPLAN_SPELL
  STR_VAR direct_res = "" spell_name = ""
  RET pxi_spell_res
BEGIN
  OUTER_SPRINT pxi_spell_res ~%direct_res%~
  ACTION_IF NOT (~%spell_name%~ STRING_EQUAL ~~) THEN BEGIN
    ACTION_IF (IDS_OF_SYMBOL (~spell~ ~%spell_name%~) >= 0) THEN BEGIN
      LAF RES_NUM_OF_SPELL_NAME
        STR_VAR spell_name = EVAL ~%spell_name%~
        RET spell_res
      END
      OUTER_SPRINT pxi_spell_res ~%spell_res%~
    END
  END
END

// @1101 - Explosion de feu (niveau 1)
LAF PXO_INTERPLAN_SPELL
  STR_VAR direct_res = ~pxl2ex2l~ spell_name = ~WIZARD_PX_FIRE_EXPLOSION~
  RET pxi_spell_res
END
ACTION_IF FILE_EXISTS_IN_GAME ~%pxi_spell_res%.spl~ THEN BEGIN
    COPY_EXISTING ~%pxi_spell_res%.spl~	~override/pxuIex2l.spl~ LPF SPELL_TO_CLERIC END
    COPY_EXISTING ~pxugbase.spl~	~override/pxgIex2l.spl~ WRITE_ASCII 0xae ~pxuIex2l~ #8
    OUTER_SPRINT urkavail_pxuiex2l ~True()~
END

// @1102 - Bouclier contre les sorts (niveau 1)
LAF PXO_INTERPLAN_SPELL
  STR_VAR direct_res = ~pxl2resi~ spell_name = ~WIZARD_PX_ANTI_SPELLS_SHIELD~
  RET pxi_spell_res
END
ACTION_IF FILE_EXISTS_IN_GAME ~%pxi_spell_res%.spl~ THEN BEGIN
    COPY_EXISTING ~%pxi_spell_res%.spl~	~override/pxuIresi.spl~ LPF SPELL_TO_CLERIC END
    COPY_EXISTING ~pxugbase.spl~	~override/pxgIresi.spl~ WRITE_ASCII 0xae ~pxuIresi~ #8
    OUTER_SPRINT urkavail_pxuiresi ~True()~
END

// @1103 - Particules magiques de Déorie (niveau 1)
LAF PXO_INTERPLAN_SPELL
  STR_VAR direct_res = ~pxl2part~ spell_name = ~WIZARD_PX_DEORIES_MAGICAL_PARTICLES~
  RET pxi_spell_res
END
ACTION_IF FILE_EXISTS_IN_GAME ~%pxi_spell_res%.spl~ THEN BEGIN
    COPY_EXISTING ~%pxi_spell_res%.spl~	~override/pxuIpart.spl~ LPF SPELL_TO_CLERIC END
    COPY_EXISTING ~pxugbase.spl~	~override/pxgIpart.spl~ WRITE_ASCII 0xae ~pxuIpart~ #8
    OUTER_SPRINT urkavail_pxuipart ~True()~
END

// @1104 - Bouffée ardente (niveau 1)
LAF PXO_INTERPLAN_SPELL
  STR_VAR direct_res = ~pxl2ecla~ spell_name = ~WIZARD_PX_FIRE_BURST~
  RET pxi_spell_res
END
ACTION_IF FILE_EXISTS_IN_GAME ~%pxi_spell_res%.spl~ THEN BEGIN
    COPY_EXISTING ~%pxi_spell_res%.spl~	~override/pxuIecla.spl~ LPF SPELL_TO_CLERIC END
    COPY_EXISTING ~pxugbase.spl~	~override/pxgIecla.spl~ WRITE_ASCII 0xae ~pxuIecla~ #8
    OUTER_SPRINT urkavail_pxuiecla ~True()~
END

// @1105 - Répulsion (niveau 1)
LAF PXO_INTERPLAN_SPELL
  STR_VAR direct_res = ~pxl2rpul~ spell_name = ~WIZARD_PX_REPULSION~
  RET pxi_spell_res
END
ACTION_IF FILE_EXISTS_IN_GAME ~%pxi_spell_res%.spl~ THEN BEGIN
    COPY_EXISTING ~%pxi_spell_res%.spl~	~override/pxuIrpul.spl~ LPF SPELL_TO_CLERIC END
    COPY_EXISTING ~pxugbase.spl~	~override/pxgIrpul.spl~ WRITE_ASCII 0xae ~pxuIrpul~ #8
    OUTER_SPRINT urkavail_pxuirpul ~True()~
END

// @1106 - Absence (niveau 1)
LAF PXO_INTERPLAN_SPELL
  STR_VAR direct_res = ~pxl2disp~ spell_name = ~WIZARD_PX_DISAPPEARANCE~
