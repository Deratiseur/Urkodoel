// Les disponibilites sont definies une seule fois, avant la compilation du dialogue.
// @8901 - Refinements - TG#AEGI
OUTER_SPRINT urkavail_pxur8901 ~False()~
ACTION_IF FILE_EXISTS_IN_GAME ~TG#AEGI.spl~ THEN BEGIN
    COPY_EXISTING ~TG#AEGI.spl~	~override/pxuR8901.spl~ LPF SPELL_TO_CLERIC9 END
    COPY_EXISTING ~pxugbase.spl~	~override/pxgR8901.spl~ WRITE_ASCII 0xae ~pxuR8901~ #8
    OUTER_SPRINT urkavail_pxur8901 ~True()~
END

