// Conditions utilisees par le dialogue pour afficher les elementaires au bon niveau.
OUTER_SPRINT urk_elemental_bg ~True()~
OUTER_SPRINT urk_elemental_iwd ~False()~
ACTION_IF GAME_IS ~IWDEE~ THEN BEGIN
    OUTER_SPRINT urk_elemental_bg ~False()~
    OUTER_SPRINT urk_elemental_iwd ~True()~
END

// Affichage des deux sorts déplacés : niveau 1 BG2EE / niveau 2 IWDEE.
OUTER_SPRINT urk_low_bg ~True()~
OUTER_SPRINT urk_low_iwd ~False()~
ACTION_IF GAME_IS ~IWDEE~ THEN BEGIN
    OUTER_SPRINT urk_low_bg ~False()~
    OUTER_SPRINT urk_low_iwd ~True()~
END

// Compilation du dialogue après la création des sorts et sous-sorts.
COMPILE EVALUATE_BUFFER ~Derats_Urkodoel/Divers/pxurkodo.d~
