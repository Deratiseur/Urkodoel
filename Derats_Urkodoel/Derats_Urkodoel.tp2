// Disponibilite des sorts facultatifs : False() par defaut.
// Chaque conversion reussie passe sa variable a True(), sans seconde verification.
/////////////////////////////////////////////////////////////////////////////////////
/////////////////////   SORTS COMMUNS A REFERENCES DIFFERENTES   //////////////////
/////////////////////////////////////////////////////////////////////////////////////
// Cécité et Protection contre la pétrification : niveau 1 BG2EE, niveau 2 IWDEE.
// Dissipation véritable : niveau 3 dans les deux jeux ; seule la ressource change.
// WIZARD_BLINDNESS
ACTION_IF (IDS_OF_SYMBOL (~spell~ ~WIZARD_BLINDNESS~) >= 0) THEN BEGIN
    LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_BLINDNESS~ RET urk_common_res = spell_res END
    ACTION_IF FILE_EXISTS_IN_GAME ~%urk_common_res%.spl~ THEN BEGIN
        COPY_EXISTING ~%urk_common_res%.spl~ ~override/pxu2106.spl~ LPF SPELL_TO_CLERIC END
        COPY_EXISTING ~pxugbase.spl~ ~override/pxg2106.spl~ WRITE_ASCII 0xae ~pxu2106~ #8
    END
END

// WIZARD_PROTECTION_FROM_PETRIFICATION
ACTION_IF (IDS_OF_SYMBOL (~spell~ ~WIZARD_PROTECTION_FROM_PETRIFICATION~) >= 0) THEN BEGIN
    LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_PROTECTION_FROM_PETRIFICATION~ RET urk_common_res = spell_res END
    ACTION_IF FILE_EXISTS_IN_GAME ~%urk_common_res%.spl~ THEN BEGIN
        COPY_EXISTING ~%urk_common_res%.spl~ ~override/pxu2108.spl~ LPF SPELL_TO_CLERIC END
        COPY_EXISTING ~pxugbase.spl~ ~override/pxg2108.spl~ WRITE_ASCII 0xae ~pxu2108~ #8
    END
END

// WIZARD_TRUE_DISPEL_MAGIC
ACTION_IF (IDS_OF_SYMBOL (~spell~ ~WIZARD_TRUE_DISPEL_MAGIC~) >= 0) THEN BEGIN
    LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_TRUE_DISPEL_MAGIC~ RET urk_common_res = spell_res END
    ACTION_IF FILE_EXISTS_IN_GAME ~%urk_common_res%.spl~ THEN BEGIN
        COPY_EXISTING ~%urk_common_res%.spl~ ~override/pxu2326.spl~ LPF SPELL_TO_CLERIC END
        COPY_EXISTING ~pxugbase.spl~ ~override/pxg2326.spl~ WRITE_ASCII 0xae ~pxu2326~ #8
    END
END

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////   ELEMENTAIRES : BG2EE / IWDEE   /////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
// Le niveau de ces trois sorts est 6 dans BG2EE et 5 dans IWDEE.
OUTER_SET urk_elem_alt_level = 5
ACTION_IF GAME_IS ~IWDEE~ THEN BEGIN
    OUTER_SET urk_elem_alt_level = 4
END

// WIZARD_CONJURE_FIRE_ELEMENTAL (niveau 6 sous BG2EE, niveau 5 sous IWDEE)
ACTION_IF (IDS_OF_SYMBOL (~spell~ ~WIZARD_CONJURE_FIRE_ELEMENTAL~) >= 0) THEN BEGIN
    LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_CONJURE_FIRE_ELEMENTAL~ RET urk_elem_res = spell_res END
    ACTION_IF FILE_EXISTS_IN_GAME ~%urk_elem_res%.spl~ THEN BEGIN
        COPY_EXISTING ~%urk_elem_res%.spl~ ~override/pxu2620.spl~ LPF SPELL_TO_CLERIC END
        COPY_EXISTING ~pxugbase.spl~ ~override/pxg2620.spl~ WRITE_ASCII 0xae ~pxu2620~ #8
    END
END

// WIZARD_CONJURE_AIR_ELEMENTAL (niveau 6 sous BG2EE, niveau 5 sous IWDEE)
ACTION_IF (IDS_OF_SYMBOL (~spell~ ~WIZARD_CONJURE_AIR_ELEMENTAL~) >= 0) THEN BEGIN
    LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_CONJURE_AIR_ELEMENTAL~ RET urk_elem_res = spell_res END
    ACTION_IF FILE_EXISTS_IN_GAME ~%urk_elem_res%.spl~ THEN BEGIN
        COPY_EXISTING ~%urk_elem_res%.spl~ ~override/pxu2621.spl~ LPF SPELL_TO_CLERIC END
        COPY_EXISTING ~pxugbase.spl~ ~override/pxg2621.spl~ WRITE_ASCII 0xae ~pxu2621~ #8
    END
END

// WIZARD_CONJURE_EARTH_ELEMENTAL (niveau 6 sous BG2EE, niveau 5 sous IWDEE)
ACTION_IF (IDS_OF_SYMBOL (~spell~ ~WIZARD_CONJURE_EARTH_ELEMENTAL~) >= 0) THEN BEGIN
    LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_CONJURE_EARTH_ELEMENTAL~ RET urk_elem_res = spell_res END
    ACTION_IF FILE_EXISTS_IN_GAME ~%urk_elem_res%.spl~ THEN BEGIN
        COPY_EXISTING ~%urk_elem_res%.spl~ ~override/pxu2622.spl~ LPF SPELL_TO_CLERIC END
        COPY_EXISTING ~pxugbase.spl~ ~override/pxg2622.spl~ WRITE_ASCII 0xae ~pxu2622~ #8
    END
END

// Convocation de monstres IV n'existe pas dans la liste d'achat BG2EE.
// Sa reference IWDEE est SPWI627 (niveau 6), contrairement aux trois elementaires.
OUTER_SPRINT urk_monster4_iwd ~False()~
ACTION_IF GAME_IS ~IWDEE~ THEN BEGIN
    ACTION_IF (IDS_OF_SYMBOL (~spell~ ~WIZARD_MONSTER_SUMMONING_4~) >= 0) THEN BEGIN
        LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_MONSTER_SUMMONING_4~ RET urk_monster4_res = spell_res END
        ACTION_IF FILE_EXISTS_IN_GAME ~%urk_monster4_res%.spl~ THEN BEGIN
            COPY_EXISTING ~%urk_monster4_res%.spl~ ~override/pxu2627.spl~ LPF SPELL_TO_CLERIC END
            COPY_EXISTING ~pxugbase.spl~ ~override/pxg2627.spl~ WRITE_ASCII 0xae ~pxu2627~ #8
            OUTER_SPRINT urk_monster4_iwd ~True()~
        END
    END
END

