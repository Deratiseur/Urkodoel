BACKUP ~Derats_Urkodoel/Backup~
AUTHOR ~Deratiseur, at the_deratiseur@hotmail.com~
VERSION ~1~

README ~Derats_Urkodoel/Documents/Readme-%LANGUAGE%.html~

AUTO_TRA ~Derats_Urkodoel/Languages/%s~

LANGUAGE ~Francais~	~French~
	~Derats_Urkodoel/Languages/French/Setup.tra~
	~Derats_Urkodoel/Languages/French/Urkodoel.tra~

LANGUAGE ~English~	~English~
	~Derats_Urkodoel/Languages/English/Setup.tra~
	~Derats_Urkodoel/Languages/English/Urkodoel.tra~


BEGIN @0 DESIGNATED 1 LABEL PX_Urkodoel
REQUIRE_PREDICATE GAME_IS ~IWDEE EET BG2EE~ @99999

COPY	~Derats_Urkodoel/Copy~					~override~
COPY	~Derats_Urkodoel/Items/Bams~			~override~
COPY	~Derats_Urkodoel/divers/pxurkodo.cre~	~override~
COPY	~Derats_Urkodoel/Items/pxubelt1.itm~	~override~	SAY NAME2 @2001	SAY DESC @2002
COPY	~Derats_Urkodoel/Items/pxuhelm1.itm~	~override~	SAY NAME2 @2003	SAY DESC @2004
COPY	~Derats_Urkodoel/Items/pxubrac1.itm~	~override~	SAY NAME2 @2005	SAY DESC @2006
COPY	~Derats_Urkodoel/Items/pxuweap1.itm~	~override~	SAY NAME2 @2007	SAY DESC @2008
COPY	~Derats_Urkodoel/Items/pxuamul1.itm~	~override~	SAY NAME2 @2009	SAY DESC @20010
COPY	~Derats_Urkodoel/Items/pxuamul2.itm~	~override~	SAY NAME2 @20011	SAY DESC @20012
COPY_EXISTING	~pxuamul2.itm~		~override/pxuamul3.itm~	SAY NAME2 @20013	SAY DESC @20014	WRITE_ASCII 0x3a ~pxuamul3~ #8	WRITE_ASCII 0x58 ~CAMUL24~ #8
COPY_EXISTING	~pxuamul2.itm~		~override/pxuamul4.itm~	SAY NAME2 @20029	SAY DESC @20030	WRITE_ASCII 0x3a ~pxuamul4~ #8	WRITE_ASCII 0x58 ~CMISC4Y~ #8
COPY	~Derats_Urkodoel/Items/pxuarmu1.itm~	~override~	SAY NAME2 @20015	SAY DESC @20016
COPY	~Derats_Urkodoel/Items/pxuarmu2.itm~	~override~	SAY NAME2 @20017	SAY DESC @20018
COPY	~Derats_Urkodoel/Items/pxuring1.itm~	~override~	SAY NAME2 @20019	SAY DESC @20020
COPY	~Derats_Urkodoel/Items/pxuring2.itm~	~override~	SAY NAME2 @20021	SAY DESC @20022
COPY	~Derats_Urkodoel/Items/pxuring3.itm~	~override~	SAY NAME2 @20023	SAY DESC @20024
COPY	~Derats_Urkodoel/Items/pxuring4.itm~	~override~	SAY NAME2 @20025	SAY DESC @20026
COPY	~Derats_Urkodoel/Items/pxuring5.itm~	~override~	SAY NAME2 @20027	SAY DESC @20028
COPY	~Derats_Urkodoel/Items/pxuweap2.itm~	~override~	SAY NAME2 @20031	SAY DESC @20032
COPY	~Derats_Urkodoel/Items/pxuring6.itm~	~override~	SAY NAME2 @20033	SAY DESC @20034

COPY	~Derats_Urkodoel/Divers/pxurkodo.sto~	~override~	SAY 0xc @5
COPY	~Derats_Urkodoel/Divers/pxurkodo.cre~	~override~	SAY NAME1 @0	SAY NAME2 @0

ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
EXTEND_BOTTOM ~AR0800.bcs~ ~Derats_Urkodoel/divers/AR0800.baf~
COPY	~Derats_Urkodoel/Anim~					~override~
END
ACTION_IF GAME_IS ~IWDEE~ THEN BEGIN
EXTEND_BOTTOM ~AR2000.bcs~ ~Derats_Urkodoel/divers/AR2000.baf~
COPY_EXISTING	~pxurkodo.cre~					~override~	WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~Lich~)) 
END

DEFINE_PATCH_FUNCTION SPELL_TO_CLERIC BEGIN 
    WRITE_LONG 0x18 (THIS | 49152)
    WRITE_BYTE 0x1c 2
	WRITE_LONG 0x1e BIT31
END

DEFINE_PATCH_FUNCTION SPELL_TO_CLERIC8 BEGIN 
    WRITE_LONG 0x18 (THIS | 49152)
    WRITE_BYTE 0x1c 2
	WRITE_LONG 0x1e BIT31
	WRITE_BYTE 0x34 7
	LPF ALTER_EFFECT INT_VAR match_power=8 power=7 silent=1 END
END

DEFINE_PATCH_FUNCTION SPELL_TO_CLERIC9 BEGIN 
    WRITE_LONG 0x18 (THIS | 49152)
    WRITE_BYTE 0x1c 2
	WRITE_LONG 0x1e BIT31
	WRITE_BYTE 0x34 7
	LPF ALTER_EFFECT INT_VAR match_power=9 power=7 silent=1 END
END

DEFINE_PATCH_FUNCTION SPELL_TO_CLERIC_ALT
    INT_VAR niveau = 1
BEGIN
    WRITE_LONG 0x18 (THIS | 49152)
    WRITE_BYTE 0x1c 2
    WRITE_LONG 0x1e BIT31
    WRITE_BYTE 0x34 niveau
    LPF ALTER_EFFECT INT_VAR match_power = (niveau + 1) power = niveau silent=1 END
END

COPY_EXISTING	~UI.MENU~	override
	REPLACE_TEXTUALLY	~mageBookEnabled[ %TAB%]+==[ %TAB%]+true~	~((mageBookEnabled == true) or (bookMode == 1))~
	REPLACE_TEXTUALLY	~mageBookEnabled[ %TAB%]+==[ %TAB%]+false~	~mageBookEnabled == false and bookMode == 0~
BUT_ONLY

