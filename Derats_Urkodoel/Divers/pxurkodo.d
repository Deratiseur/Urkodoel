// Urkodoel : dialogue d'accueil et boutique.
// Les propositions d'apprentissage des sorts seront ajoutees ulterieurement.
// Textes : Urkodoel.tra

BEGIN ~PXURKODO~

// Premiere rencontre (quelle que soit la classe du personnage qui parle).
IF ~Global("pxurkintro","GLOBAL",0)~ THEN BEGIN PremiereRencontre
    SAY @1
    IF ~~ THEN REPLY @2 DO ~SetGlobal("pxurkintro","GLOBAL",1)~ GOTO AutresClasses
    IF ~~ THEN REPLY @3 DO ~SetGlobal("pxurkintro","GLOBAL",1)~ GOTO Explication
END

IF ~~ THEN BEGIN AutresClasses
    SAY @4
    IF ~~ THEN REPLY @5 GOTO Explication
    IF ~~ THEN REPLY @40 EXIT
END

IF ~~ THEN BEGIN Explication
    SAY @6
    IF ~~ THEN REPLY @7 GOTO Prix
    IF ~~ THEN REPLY @40 EXIT
END


IF ~~ THEN BEGIN Prix
    SAY @8 = @9
      IF ~OR(2)
        Class(LastTalkedToBy(Myself),CLERIC_ALL)
        Class(LastTalkedToBy(Myself),DRUID_ALL)~
        THEN REPLY @12 DO ~StartStore("pxurkodo",LastTalkedToBy(Myself))~ EXIT
	IF ~OR(2)
        Class(LastTalkedToBy(Myself),CLERIC_ALL)
        Class(LastTalkedToBy(Myself),DRUID_ALL)~
        THEN REPLY @11 GOTO Choixniveau
    IF ~~ THEN REPLY @40 EXIT
END

// Visites suivantes : pretre, druide ou chaman.
IF ~Global("pxurkintro","GLOBAL",1)
    OR(2)
        Class(LastTalkedToBy(Myself),CLERIC_ALL)
        Class(LastTalkedToBy(Myself),DRUID_ALL)~ THEN BEGIN RetourDivin
    SAY @10
   IF ~OR(2)
        Class(LastTalkedToBy(Myself),CLERIC_ALL)
        Class(LastTalkedToBy(Myself),DRUID_ALL)~
        THEN REPLY @11 GOTO Choixniveau
    IF ~OR(2)
        Class(LastTalkedToBy(Myself),CLERIC_ALL)
        Class(LastTalkedToBy(Myself),DRUID_ALL)~
		THEN REPLY @12 DO ~StartStore("pxurkodo",LastTalkedToBy(Myself))~ EXIT
    IF ~~ THEN REPLY @13 GOTO RappelPrix
    IF ~~ THEN REPLY @14 EXIT
END

IF ~~ THEN BEGIN RappelPrix
    SAY @19
    IF ~OR(2)
        Class(LastTalkedToBy(Myself),CLERIC_ALL)
        Class(LastTalkedToBy(Myself),DRUID_ALL)~
		THEN REPLY @12 DO ~StartStore("pxurkodo",LastTalkedToBy(Myself))~ EXIT
    IF ~~ THEN REPLY @14 EXIT
END

// Visites suivantes : autres classes (pas de magasin utilisable).
IF ~Global("pxurkintro","GLOBAL",1)
    !Class(LastTalkedToBy(Myself),CLERIC_ALL)
    !Class(LastTalkedToBy(Myself),DRUID_ALL)~ THEN BEGIN RetourAutres
    SAY @15
    IF ~~ THEN REPLY @16 GOTO RienPourVous
    IF ~~ THEN REPLY @17 GOTO PourquoiPas
    IF ~~ THEN REPLY @18 EXIT
END

IF ~~ THEN BEGIN RienPourVous
    SAY @21
    IF ~~ THEN REPLY @18 EXIT
END

IF ~~ THEN BEGIN PourquoiPas
    SAY @20
    IF ~~ THEN REPLY @18 EXIT
END

